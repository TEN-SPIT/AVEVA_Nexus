<mxfile host="drawio" version="26.0.0"><diagram id="d1" name="Escritura"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Cómo se escribe en el modelo" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#0070EF;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="800" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Escribir y guardar son dos pasos distintos, y cada uno pasa por el guardarraíl" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#878787;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="900" height="20" as="geometry"/></mxCell><mxCell id="rule" value="" style="line;strokeWidth=1;strokeColor=#DEDEDE;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1089" height="6" as="geometry"/></mxCell><mxCell id="n1" value="Claude pide run_pml (por ejemplo NEW EQUI)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#004C83;strokeColor=#004C83;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="140" height="70" as="geometry"/></mxCell><mxCell id="d1" value="¿Sesión escribible y base permitida?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0070EF;strokeWidth=1.5;fontColor=#535552;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="180" height="90" as="geometry"/></mxCell><mxCell id="n2" value="nexus_client envía la petición con token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="160" height="70" as="geometry"/></mxCell><mxCell id="n3" value="Nexus ejecuta cada línea en E3D, en el hilo de la interfaz si hay gráficos" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="200" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Cambio pendiente en la sesión, sin guardar" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#DEDEDE;fontColor=#535552;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="160" height="70" as="geometry"/></mxCell><mxCell id="r1" value="Rechazado con mensaje claro; nada se ejecuta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EE7766;strokeColor=#EE7766;fontColor=#000000;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="270" width="180" height="60" as="geometry"/></mxCell><mxCell id="n5" value="Claude pide save_work de una base" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#004C83;strokeColor=#004C83;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="140" height="70" as="geometry"/></mxCell><mxCell id="d2" value="¿La base está en write_dbs?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0070EF;strokeWidth=1.5;fontColor=#535552;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="410" width="180" height="90" as="geometry"/></mxCell><mxCell id="n6" value="SAVEWORK solo de esa base" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="420" width="160" height="70" as="geometry"/></mxCell><mxCell id="n7" value="UNCLAIM ALL libera los claims" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="420" width="200" height="70" as="geometry"/></mxCell><mxCell id="n8" value="Guardado y liberado" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#80C7A0;strokeColor=#80C7A0;fontColor=#000000;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="160" height="70" as="geometry"/></mxCell><mxCell id="r2" value="Rechazado; el cambio se pierde al parar la sesión" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EE7766;strokeColor=#EE7766;fontColor=#000000;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="180" height="60" as="geometry"/></mxCell><mxCell id="note" value="Reglas&lt;br&gt;• SAVEWORK suelto dentro de run_pml se rechaza, también abreviado.&lt;br&gt;• SAVEWORK de una base guarda solo esa base; los cambios en otras bases se descartan al parar.&lt;br&gt;• stop_e3d se niega mientras queden claims, para no dejarlos huérfanos.&lt;br&gt;• Si Claude trabaja en tu sesión gráfica, save_work guarda también tus cambios pendientes de esa base." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;fontColor=#878787;" vertex="1" parent="1"><mxGeometry x="480" y="540" width="640" height="100" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#535552;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#535552;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n1" target="d1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#535552;strokeWidth=1.5;endArrow=block;endFill=1;fontFamily=Arial;fontSize=11;fontColor=#535552;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d1" target="n2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#53555