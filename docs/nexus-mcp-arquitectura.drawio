<mxfile host="drawio" version="26.0.0"><diagram id="d1" name="Nexus MCP"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Cómo funciona Nexus MCP" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontStyle=1;fontColor=#0070EF;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="700" height="40" as="geometry"/></mxCell><mxCell id="sub" value="Una petición: cliente de IA, servidor MCP (Python), Nexus dentro de E3D y modelo" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#878787;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="900" height="20" as="geometry"/></mxCell><mxCell id="rule" value="" style="line;strokeWidth=1;strokeColor=#DEDEDE;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1089" height="6" as="geometry"/></mxCell><mxCell id="g1" value="Cliente de IA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#DEDEDE;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#004C83;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="170" as="geometry"/></mxCell><mxCell id="c1" value="Claude Code, Claude Desktop, Cursor y otros clientes MCP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#004C83;strokeColor=#004C83;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="g1"><mxGeometry x="20" y="50" width="160" height="90" as="geometry"/></mxCell><mxCell id="g2" value="Servidor MCP (Python, carpeta mcp)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#DEDEDE;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#004C83;fontFamily=Arial;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="360" height="500" as="geometry"/></mxCell><mxCell id="t1" value="Consulta: session_info, query_elements, get_attributes, list_children, attribute_list" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="g2"><mxGeometry x="20" y="40" width="320" height="56" as="geometry"/></mxCell><mxCell id="t4" value="Sesión: e3d_projects, start_e3d, stop_e3d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="g2"><mxGeometry x="20" y="106" width="320" height="40" as="geometry"/></mxCell><mxCell id="t5" value="Pruebas de PML: save_pml, delete_pml, list_pml (sandbox mcp*)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070EF;strokeColor=#0070EF;fontColor=#FFFFFF;fontFamily=Arial;fontSize=12;" vertex="1" parent="g2"><mxGeometry x="20" y="156" width="320" height="40" as="geometry"/></mxCell><mxCell id="gw" value="Guardarraíl (write_guard)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#DEDEDE;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontStyle=1;fontColor=#004C83;fontFamily=Arial;fontSize=12;" vertex="1" parent="g2"><mxGeometry x="20" y="206" width="320" height="170" as="geometry"/></mxCell><mxCell id="t2" value="run_pml: ejecuta PML y devuelve Errors y Log. Rechaza SAVEWORK y bases no permitidas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0070EF;strokeWidth=1.5;fontColor=#535552;fontFamily=Arial;fontSize=12;" vertex="1" parent="gw"><mxGeometry x="10" y="36" width="300" height="56" as="geometry"/></mxCell><mxCell id="t3" value="save_work: SAVEWORK de una base permitida y UNCLAIM ALL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0070EF;strokeWidth=1.5;fontColor=#535552;fontFamily=Arial;fontSize=12;" vertex="1" parent="gw"><mxGeometry x="10" y="102" width="300" height="56"