--|------------------------------------------------------------------------------------------------

-- Muestra un mensaje al usuario. Con interfaz grafica usa un aviso de E3D; sin ella (sesion TTY)
-- lo escribe en la consola, para que las funciones de Nexus tambien se puedan probar sin graficos.
--
--     !!nexusmsg('texto', FALSE)     informacion
--     !!nexusmsg('texto', TRUE)      error
--
-- El ultimo mensaje queda en !!nexusLastMsg (y !!nexusLastErr = TRUE si era un error).
-- Con !!nexusQuiet = TRUE no se abre ningun aviso: el panel !!nexusmcp lo usa para mostrar el
-- mensaje en su propia linea de estado (y para que un aviso modal no bloquee E3D).

define function !!nexusmsg(!text is STRING, !iserror is BOOLEAN)

    $P NEXUS: $!text
    !!nexusLastMsg = !text
    !!nexusLastErr = !iserror

    !quiet = FALSE
    !quiet = !!nexusQuiet
    handle any
        !quiet = FALSE
    endhandle
    if !quiet then
        return
    endif

    if !iserror then
        !!alert.error(!text)
        handle any
        endhandle
    else
        !!alert.message(!text)
        handle any
        endhandle
    endif

endfunction
